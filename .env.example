# ZAEVI backend environment configuration.
# Copy this file to `.env` and replace the placeholder values.
# Never commit a real `.env` file.

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the Express server listens on.
PORT=3000

# MySQL database URL (Prisma DATABASE_URL) - REQUIRED
# Replace with your own connection string; do not commit real credentials.
# Must start with "mysql://". Used by the server at startup and by Prisma CLI
# commands (validate/generate/migrate).
DATABASE_URL="mysql://root:password@localhost:3306/zaevi"

# Optional: charset/ssl can be configured via the connection string.
# Example: mysql://user:pass@localhost:3306/zaevi?connection_limit=10

# Order-creation rate limit for POST /api/orders, per client IP.
# Fixed window: at most ORDER_RATE_LIMIT_MAX requests per
# ORDER_RATE_LIMIT_WINDOW_MS milliseconds. Exceeding it returns HTTP 429.
# Counters are in-memory and local to this process (not shared across
# instances) and reset on restart.
ORDER_RATE_LIMIT_MAX=30
ORDER_RATE_LIMIT_WINDOW_MS=60000

# Authentication
# Session secret for signing/encrypting session cookies.
# REQUIRED in production; must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Auth rate limit for POST /api/auth/register and POST /api/auth/login, per client IP.
# Separate from order rate limit.
# Fixed window: at most AUTH_RATE_LIMIT_MAX requests per
# AUTH_RATE_LIMIT_WINDOW_MS milliseconds.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Razorpay payments. Leave empty until you have real keys: the Pay Now button stays
# hidden and orders can still be placed. Keys come from the Razorpay dashboard.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook URL to register in Razorpay: https://<your-domain>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=""

# Outbound email over authenticated SMTP, used for sign-in codes, password reset, order
# updates, refund notices, the newsletter welcome and contact-form alerts.
# All four of SMTP_HOST, SMTP_USER, SMTP_PASS and EMAIL_FROM are required.
# IMPORTANT: sign-up, sign-in and password reset all need email. Without these settings,
# nobody can sign in on production. Check them with: npm run check:email -- you@example.com
# Notifications are still stored while email is missing, and admins can retry them later.
# Resend: host smtp.resend.com, user "resend", password = your Resend API key, and a
# sender on a domain verified in Resend.
# Keep port 2587: Render's free plan blocks outbound 25, 465 and 587.
SMTP_HOST=""
SMTP_PORT=2587
# "true" only for implicit-TLS ports (465, 2465).
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
# Sender address, for example: ZAEVI <clients@your-domain.com>
EMAIL_FROM=""
# Where new contact-form messages are sent.
CONTACT_NOTIFY_EMAIL=""

# Database environments. See "Database environments" in README.md.
# Development and test always use zaevi_test, even if DATABASE_URL names zaevi.
# Production needs NODE_ENV=production, DATABASE_URL naming zaevi, and this flag.
# Set it to true only when launch has been approved; otherwise production refuses to start.
ZAEVI_PRODUCTION_DB_APPROVED=false
# Refuses to import products.json into production until its photos are approved.
ALLOW_PRODUCTION_CATALOG_IMPORT=false

# Hosting. See docs/deployment.md.
# Shared secret that lets this server trust the visitor address sent by the Vercel proxy.
# Set the same long random value on Render and Vercel. Leave empty for local development.
PROXY_SECRET=""
# Where uploaded images are stored. Empty means ../zaevi-cms-uploads beside the project.
# On hosting, point this at a persistent disk or uploads vanish on every restart.
UPLOAD_DIR=""

# Emergency admin sign-in for when email is down. Leave off. To use it, run
# npm run admin:recovery and follow "Emergency admin sign-in" in docs/deployment.md.
ADMIN_RECOVERY_ENABLED=false
ADMIN_RECOVERY_EMAIL=""
ADMIN_RECOVERY_EXPIRES_AT=""
ADMIN_RECOVERY_CODE_HASH=""

# The one official public contact address, used on the website and on invoices.
# Leave empty until the address has been verified: the website then shows only the
# contact form. CONTACT_NOTIFY_EMAIL above defaults to this address if it is empty.
CONTACT_EMAIL=""

# Your verified GST number, printed on invoices. While it is empty or badly formatted,
# invoices show a clearly marked placeholder instead.
BUSINESS_GSTIN=""

