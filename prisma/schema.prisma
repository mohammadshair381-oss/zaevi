// ZAEVI Prisma schema — Master E-Commerce Specification
// https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Catalog product, derived from `products.json`.
model Product {
  id            String        @id @db.VarChar(32)
  name          String        @db.VarChar(200)
  category      String        @db.VarChar(100)
  gender        String        @db.VarChar(20)
  price         Int           @db.UnsignedInt
  color         String        @db.VarChar(50)
  imageUrl      String        @db.VarChar(1024)
  hoverImageUrl String        @db.VarChar(1024)
  description   String        @db.Text
  available     Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sizes         ProductSize[]
  orderItems    OrderItem[]
  reviews       Review[]

  @@index([category])
  @@index([gender])
  @@index([available])
}

/// A selectable size for a product.
model ProductSize {
  id        Int     @id @default(autoincrement())
  productId String  @db.VarChar(32)
  size      String  @db.VarChar(20)
  position  Int     @db.UnsignedInt
  stock     Int?    @ignore @db.UnsignedInt
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size])
  @@index([productId])
}

/// A storefront customer.
model Customer {
  id                            Int                      @id @default(autoincrement())
  email                         String                   @unique @db.VarChar(255)
  name                          String?                  @db.VarChar(200)
  phone                         String?                  @db.VarChar(32)
  passwordHash                  String?                  @db.VarChar(255)
  emailVerifiedAt               DateTime?
  role                          String                   @default("customer") @db.VarChar(20)
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  orders                        Order[]
  addresses                     Address[]
  updatedWebsiteSettings        WebsiteSetting[]         @relation("WebsiteSettingUpdatedBy")
  authoredCmsRevisions          CmsPageRevision[]        @relation("CmsRevisionAuthor")
  uploadedMediaAssets           MediaAsset[]             @relation("MediaAssetAuthor")
  reviews                       Review[]
  notifications                 Notification[]
  couponUsages                  CouponUsage[]
  deliveryConfigs               DeliveryEstimateConfig[] @relation("DeliveryConfigUpdatedBy")
  cancellationRequestsRequested CancellationRequest[]   @relation("CancellationRequestedBy")
  cancellationRequestsDecided   CancellationRequest[]   @relation("CancellationDecidedBy")
  returnRequestsRequested       ReturnRequest[]          @relation("ReturnRequestedBy")
  returnRequestsDecided         ReturnRequest[]          @relation("ReturnDecidedBy")
  replacementRequestsRequested  ReplacementRequest[]     @relation("ReplacementRequestedBy")
  replacementRequestsDecided    ReplacementRequest[]     @relation("ReplacementDecidedBy")
  statusHistoryChanges          OrderStatusHistory[]     @relation("StatusHistoryChangedBy")
  passwordResetTokens           PasswordResetToken[]
  emailOtps                     EmailOtp[]
}

/// Customer delivery address saved to account.
model Address {
  id           Int      @id @default(autoincrement())
  customerId   Int
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName     String   @db.VarChar(200)
  phone        String   @db.VarChar(32)
  addressLine1 String   @db.VarChar(500)
  addressLine2 String?  @db.VarChar(500)
  landmark     String?  @db.VarChar(200)
  locality     String?  @db.VarChar(200)
  city         String   @db.VarChar(120)
  state        String   @db.VarChar(120)
  postalCode   String   @db.VarChar(20)
  country      String   @default("IN") @db.Char(2)
  label        String?  @db.VarChar(50)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
  @@index([customerId, isDefault])
}

/// A placed order.
model Order {
  id                            Int                   @id @default(autoincrement())
  reference                     String                @unique @db.VarChar(32)
  idempotencyKey                String?               @unique @db.VarChar(64)
  idempotencyHash               String?               @db.VarChar(64)
  customerId                    Int?
  customer                      Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status                        String                @default("pending") @db.VarChar(20)
  currency                      String                @default("INR") @db.Char(3)
  subtotalMinor                 Int                   @db.UnsignedInt
  discountMinor                 Int                   @default(0) @db.UnsignedInt
  totalMinor                    Int                   @db.UnsignedInt
  couponId                      Int?
  coupon                        Coupon?               @relation(fields: [couponId], references: [id], onDelete: SetNull)
  notes                         String?               @db.VarChar(500)
  contactEmail                  String                @db.VarChar(255)
  contactPhone                  String?               @db.VarChar(32)
  shippingName                  String?               @db.VarChar(200)
  shippingAddress               String?               @db.VarChar(500)
  shippingCity                  String?               @db.VarChar(120)
  shippingPostalCode            String?               @db.VarChar(20)
  shippingCountry               String                @default("IN") @db.Char(2)
  estimatedDispatchAt           DateTime?
  estimatedProductionCompleteAt DateTime?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  items                         OrderItem[]
  payments                      Payment[]
  statusHistory                 OrderStatusHistory[]
  shipments                     Shipment[]
  cancellationRequest           CancellationRequest?
  returnRequests                ReturnRequest[]
  replacementRequests           ReplacementRequest[]
  couponUsages                  CouponUsage[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

/// A single line on an order.
model OrderItem {
  id               Int               @id @default(autoincrement())
  orderId          Int
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?           @db.VarChar(32)
  product          Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSku       String            @db.VarChar(32)
  productName      String            @db.VarChar(200)
  size             String?           @db.VarChar(20)
  unitPriceMinor   Int               @db.UnsignedInt
  quantity         Int               @db.UnsignedInt
  lineTotalMinor   Int               @db.UnsignedInt
  createdAt        DateTime          @default(now())
  returnItems      ReturnItem[]
  replacementItems ReplacementItem[]

  @@index([orderId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Production Lifecycle & Logistics
// ---------------------------------------------------------------------------

model OrderStatusHistory {
  id             Int       @id @default(autoincrement())
  orderId        Int
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus String?   @db.VarChar(20)
  newStatus      String    @db.VarChar(20)
  note           String?   @db.VarChar(500)
  visibility     String    @default("customer") @db.VarChar(20)
  changedBy      Int?
  changedByEmail String?   @db.VarChar(255)
  customer       Customer? @relation("StatusHistoryChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([orderId, createdAt])
  @@index([changedBy])
}

model Shipment {
  id                  Int                 @id @default(autoincrement())
  orderId             Int
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type                String              @default("outbound") @db.VarChar(20)
  carrier             String?             @db.VarChar(120)
  trackingNumber      String?             @db.VarChar(120)
  trackingUrl         String?             @db.VarChar(1024)
  dispatchedAt        DateTime?
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  returnRequest       ReturnRequest?
  replacementRequest  ReplacementRequest?

  @@index([orderId, type])
  @@index([trackingNumber])
}

model DeliveryEstimateConfig {
  id               Int       @id @default(1)
  productionDays   Int       @default(0)
  qualityCheckDays Int       @default(0)
  packingDays      Int       @default(0)
  shippingDays     Int       @default(0)
  bufferDays       Int       @default(0)
  updatedAt        DateTime  @updatedAt
  updatedBy        Int?
  updatedByEmail   String?   @db.VarChar(255)
  customer         Customer? @relation("DeliveryConfigUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
}

model CancellationRequest {
  id             Int       @id @default(autoincrement())
  orderId        Int       @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason         String    @db.VarChar(500)
  status         String    @default("pending") @db.VarChar(20)
  idempotencyKey String?   @unique @db.VarChar(64)
  requestedBy    Int?
  requester      Customer? @relation("CancellationRequestedBy", fields: [requestedBy], references: [id], onDelete: SetNull)
  requesterEmail String?   @db.VarChar(255)
  decidedBy      Int?
  decider        Customer? @relation("CancellationDecidedBy", fields: [decidedBy], references: [id], onDelete: SetNull)
  deciderEmail   String?   @db.VarChar(255)
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

model ReturnRequest {
  id               Int          @id @default(autoincrement())
  orderId          Int
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason           String       @db.VarChar(500)
  status           String       @default("pending") @db.VarChar(20)
  refundStatus     String       @default("not_applicable") @db.VarChar(20)
  idempotencyKey   String?      @unique @db.VarChar(64)
  requestedBy      Int?
  requester        Customer?    @relation("ReturnRequestedBy", fields: [requestedBy], references: [id], onDelete: SetNull)
  requesterEmail   String?      @db.VarChar(255)
  decidedBy        Int?
  decider          Customer?    @relation("ReturnDecidedBy", fields: [decidedBy], references: [id], onDelete: SetNull)
  deciderEmail     String?      @db.VarChar(255)
  decidedAt        DateTime?
  receivedAt       DateTime?
  returnShipmentId Int?         @unique
  returnShipment   Shipment?    @relation(fields: [returnShipmentId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  items            ReturnItem[]

  @@index([orderId, status])
}

model ReturnItem {
  id              Int           @id @default(autoincrement())
  returnRequestId Int
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     Int
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity        Int           @db.UnsignedInt
  createdAt       DateTime      @default(now())

  @@unique([returnRequestId, orderItemId])
  @@index([returnRequestId])
}

model ReplacementRequest {
  id                    Int               @id @default(autoincrement())
  orderId               Int
  order                 Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason                String            @db.VarChar(500)
  status                String            @default("pending") @db.VarChar(20)
  idempotencyKey        String?           @unique @db.VarChar(64)
  requestedBy           Int?
  requester             Customer?         @relation("ReplacementRequestedBy", fields: [requestedBy], references: [id], onDelete: SetNull)
  requesterEmail        String?           @db.VarChar(255)
  decidedBy             Int?
  decider               Customer?         @relation("ReplacementDecidedBy", fields: [decidedBy], references: [id], onDelete: SetNull)
  deciderEmail          String?           @db.VarChar(255)
  decidedAt             DateTime?
  replacementShipmentId Int?              @unique
  replacementShipment   Shipment?         @relation(fields: [replacementShipmentId], references: [id], onDelete: SetNull)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  items                 ReplacementItem[]

  @@index([orderId, status])
}

model ReplacementItem {
  id                   Int                @id @default(autoincrement())
  replacementRequestId Int
  replacementRequest   ReplacementRequest @relation(fields: [replacementRequestId], references: [id], onDelete: Cascade)
  orderItemId          Int
  orderItem            OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity             Int                @db.UnsignedInt
  createdAt            DateTime           @default(now())

  @@unique([replacementRequestId, orderItemId])
  @@index([replacementRequestId])
}

// ---------------------------------------------------------------------------
// Coupons & Promotions
// ---------------------------------------------------------------------------

model Coupon {
  id               Int           @id @default(autoincrement())
  code             String        @unique @db.VarChar(32)
  description      String?       @db.VarChar(255)
  discountType     String        @default("percentage") @db.VarChar(20) // 'percentage' | 'fixed'
  discountValue    Int           @db.UnsignedInt // Percentage value or paise amount
  minOrderMinor    Int           @default(0) @db.UnsignedInt
  maxDiscountMinor Int?          @db.UnsignedInt
  startsAt         DateTime?
  expiresAt        DateTime?
  usageLimit       Int?          @db.UnsignedInt
  usedCount        Int           @default(0) @db.UnsignedInt
  perCustomerLimit Int?          @db.UnsignedInt
  requiresNewsletter Boolean     @default(false)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  orders           Order[]
  usages           CouponUsage[]

  @@index([code])
  @@index([isActive])
}

model CouponUsage {
  id                  Int       @id @default(autoincrement())
  couponId            Int
  coupon              Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId             Int
  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId          Int?
  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discountAmountMinor Int       @db.UnsignedInt
  createdAt           DateTime  @default(now())

  @@index([couponId])
  @@index([orderId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Customer Reviews & Ratings
// ---------------------------------------------------------------------------

model Review {
  id               Int       @id @default(autoincrement())
  productId        String    @db.VarChar(32)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId       Int?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName       String    @db.VarChar(120)
  rating           Int       @db.UnsignedTinyInt
  title            String?   @db.VarChar(200)
  content          String    @db.Text
  status           String    @default("pending") @db.VarChar(20) // 'pending' | 'approved' | 'rejected'
  verifiedPurchase Boolean   @default(false)
  helpfulCount     Int       @default(0) @db.UnsignedInt
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([productId, status])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Marketing & Communications
// ---------------------------------------------------------------------------

model NewsletterSubscriber {
  id             Int       @id @default(autoincrement())
  email          String    @unique @db.VarChar(255)
  status         String    @default("subscribed") @db.VarChar(20) // 'subscribed' | 'unsubscribed'
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([status])
}

model Notification {
  id             Int       @id @default(autoincrement())
  customerId     Int?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  recipientEmail String    @db.VarChar(255)
  type           String    @db.VarChar(50)
  subject        String    @db.VarChar(255)
  content        String    @db.Text
  status         String    @default("pending") @db.VarChar(20) // 'pending' | 'sent' | 'failed' | 'not_configured'
  errorMessage   String?   @db.VarChar(500)
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([type])
}

model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  customerId Int
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

// A single row holding the storefront content edited in Site Studio.
model EmailOtp {
  id            Int       @id @default(autoincrement())
  customerId    Int
  purpose       String    @db.VarChar(20) // 'signup' | 'login' | 'reset'
  challengeHash String    @unique @db.Char(64)
  codeHash      String    @db.Char(64)
  attempts      Int       @default(0)
  sendCount     Int       @default(1)
  lastSentAt    DateTime
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purpose])
}

model SiteStudio {
  id          Int       @id @default(1)
  draft       Json
  published   Json?
  previous    Json?
  publishedAt DateTime?
  updatedBy   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

model ContactMessage {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(120)
  email          String   @db.VarChar(255)
  orderReference String?  @db.VarChar(40)
  subject        String   @db.VarChar(40)
  message        String   @db.Text
  status         String   @default("new") @db.VarChar(20) // 'new' | 'read' | 'resolved'
  notifyStatus   String   @default("pending") @db.VarChar(20) // 'pending' | 'sent' | 'failed' | 'not_configured'
  notifyError    String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

// ---------------------------------------------------------------------------
// CMS Foundation
// ---------------------------------------------------------------------------

model WebsiteSetting {
  id                    Int       @id @default(1)
  siteName              String    @db.VarChar(120)
  logoUrl               String?   @db.VarChar(1024)
  faviconUrl            String?   @db.VarChar(1024)
  primaryColor          String    @default("#111111") @db.Char(7)
  secondaryColor        String    @default("#f5f5f3") @db.Char(7)
  accentColor           String    @default("#111111") @db.Char(7)
  backgroundColor       String    @default("#ffffff") @db.Char(7)
  textColor             String    @default("#111111") @db.Char(7)
  headingFont           String    @default("Playfair Display") @db.VarChar(80)
  bodyFont              String    @default("Inter") @db.VarChar(80)
  headerLayout          String    @default("default") @db.VarChar(40)
  footerLayout          String    @default("default") @db.VarChar(40)
  announcementEnabled   Boolean   @default(false)
  announcementText      String    @default("") @db.VarChar(240)
  announcementLink      String    @default("") @db.VarChar(1024)
  socialLinks           Json?
  defaultSeoTitle       String?   @db.VarChar(160)
  defaultSeoDescription String?   @db.VarChar(320)
  themeTokens           Json?
  updatedBy             Int?
  updatedByCustomer     Customer? @relation("WebsiteSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model CmsPage {
  id                  Int              @id @default(autoincrement())
  slug                String           @unique @db.VarChar(80)
  title               String           @db.VarChar(200)
  seoTitle            String?          @db.VarChar(160)
  seoDescription      String?          @db.VarChar(320)
  status              String           @default("draft") @db.VarChar(20)
  draftRevisionId     Int?             @unique
  publishedRevisionId Int?             @unique
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  revisions           CmsPageRevision[]
  draftRevision       CmsPageRevision? @relation("CmsPageDraftRevision", fields: [draftRevisionId], references: [id], onDelete: SetNull)
  publishedRevision   CmsPageRevision? @relation("CmsPagePublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
}

model CmsPageRevision {
  id           Int        @id @default(autoincrement())
  pageId       Int
  page         CmsPage    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version      Int
  snapshot     Json
  createdBy    Int?
  author       Customer?  @relation("CmsRevisionAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  publishedAt  DateTime?
  note         String?    @db.VarChar(500)
  draftFor     CmsPage?   @relation("CmsPageDraftRevision")
  publishedFor CmsPage?   @relation("CmsPagePublishedRevision")

  @@unique([pageId, version])
  @@index([pageId, createdAt])
}

model MediaAsset {
  id         Int       @id @default(autoincrement())
  storageKey String    @unique @db.VarChar(160)
  url        String    @db.VarChar(255)
  mimeType   String    @db.VarChar(64)
  width      Int?
  height     Int?
  alt        String?   @db.VarChar(200)
  sizeBytes  Int       @db.UnsignedInt
  createdBy  Int?
  author     Customer? @relation("MediaAssetAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Payment Models
// ---------------------------------------------------------------------------

model Payment {
  id                 Int            @id @default(autoincrement())
  orderId            Int
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider           String         @default("razorpay") @db.VarChar(40)
  providerOrderId    String?        @unique @db.VarChar(80)
  providerPaymentId  String?        @unique @db.VarChar(80)
  amountMinor        Int            @db.UnsignedInt
  currency           String         @default("INR") @db.Char(3)
  status             String         @default("created") @db.VarChar(30)
  method             String?        @db.VarChar(40)
  failureCode        String?        @db.VarChar(80)
  failureDescription String?        @db.VarChar(500)
  capturedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  events             PaymentEvent[]
  refunds            Refund[]

  @@index([orderId, createdAt])
  @@index([status])
}

model PaymentEvent {
  id          Int       @id @default(autoincrement())
  paymentId   Int?
  payment     Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  eventId     String    @unique @db.VarChar(120)
  eventType   String    @db.VarChar(80)
  payload     String    @db.Text
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([paymentId])
}

model Refund {
  id                 Int       @id @default(autoincrement())
  paymentId          Int
  payment            Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  providerRefundId   String?   @unique @db.VarChar(80)
  amountMinor        Int       @db.UnsignedInt
  currency           String    @default("INR") @db.Char(3)
  status             String    @default("created") @db.VarChar(30)
  reason             String?   @db.VarChar(500)
  failureCode        String?   @db.VarChar(80)
  failureDescription String?   @db.VarChar(500)
  processedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([paymentId, createdAt])
}
