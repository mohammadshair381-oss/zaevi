{
    "name": "zaevi",
    "version": "0.1.0",
    "description": "ZAEVI storefront + backend — Express, Prisma, MySQL; read-only product catalog API, health endpoint, static storefront",
    "private": true,
    "type": "module",
    "main": "src/server.js",
    "engines": {
        "node": ">=20.11.0"
    },
    "scripts": {
        "start": "node src/server.js",
    "build:static": "node scripts/build-static.mjs",
        "dev": "node --watch src/server.js",
        "test": "node --test --test-concurrency=1",
        "check:email": "node scripts/check-email.mjs",
    "admin:recovery": "node scripts/create-admin-recovery.mjs",
        "prisma:generate": "prisma generate",
        "prisma:validate": "prisma validate",
        "import:products": "node scripts/import-products.js"
    },
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "dotenv": "^18.0.6",
        "express": "^5.2.1",
        "nodemailer": "^10.3.1"
    },
    "devDependencies": {
        "prisma": "^6.19.3",
        "supertest": "^7.3.1"
    },
    "overrides": {
        "deepmerge-ts": "^8.0.0"
    }
}
